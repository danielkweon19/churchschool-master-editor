{
  "name": "pdf-master-editor-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "python3 scripts/prepare_source.py",
    "dev": "python3 scripts/dev.py",
    "dev:ui": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:backend": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^2.1.8"
  }
}
